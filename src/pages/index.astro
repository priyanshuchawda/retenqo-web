---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';
import {
  ShieldCheck,
  Smartphone,
  Cpu,
  Bell,
  Camera,
  Mic,
  Search,
  CheckCircle2,
  Lock,
  ArrowRight,
} from 'lucide-astro';

const workflowSteps = [
  {
    step: '01',
    title: 'Capture',
    description:
      'Opt-in capture from notifications, screenshots, voice notes, or quick text entries.',
  },
  {
    step: '02',
    title: 'Understand',
    description:
      'On-device AI extracts commitments, dates, and context without sending data to the cloud.',
  },
  {
    step: '03',
    title: 'Remember',
    description:
      'Memories are indexed locally in an encrypted store under your full control.',
  },
  {
    step: '04',
    title: 'Retrieve',
    description:
      'Ask natural questions and get source-backed answers linked to the original capture.',
  },
];

const capabilities = [
  {
    icon: Bell,
    title: 'Opt-in Notification Capture',
    description:
      'Choose exactly which apps can contribute to your memory. Sensitive apps stay excluded.',
  },
  {
    icon: Camera,
    title: 'Screenshot Understanding',
    description:
      'On-device OCR extracts text, dates, and action items from saved screenshots.',
  },
  {
    icon: Mic,
    title: 'Voice-to-Memory',
    description:
      'Record quick voice thoughts and convert them into searchable, structured memories.',
  },
  {
    icon: Cpu,
    title: 'Local AI Assistant',
    description:
      'Run inference directly on your Android device with offline-capable models.',
  },
  {
    icon: Search,
    title: 'Source-Backed Answers',
    description:
      'Every AI answer links back to the exact saved memory so you can verify it.',
  },
  {
    icon: CheckCircle2,
    title: 'Commitment Tracking',
    description:
      'Automatically surface upcoming deadlines and turn them into smart reminders.',
  },
  {
    icon: Lock,
    title: 'Encrypted Backups',
    description:
      'Export and restore your personal memory archive with user-controlled encryption.',
  },
  {
    icon: ShieldCheck,
    title: 'Granular Privacy Controls',
    description:
      'Pause capture anytime, delete individual memories, or wipe everything locally.',
  },
];
---

<BaseLayout title={SITE_CONFIG.name}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Retenqo',
        operatingSystem: 'Android',
        applicationCategory: 'ProductivityApplication',
        description: SITE_CONFIG.description,
        url: SITE_CONFIG.url,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
      })}
    />
  </Fragment>

  <!-- Hero Section -->
  <section
    class="border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]"
  >
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-12 lg:items-center lg:py-24"
    >
      <div class="lg:col-span-7">
        <p
          class="text-xs font-semibold tracking-widest text-[var(--accent-primary)] uppercase"
        >
          Your Personal Memory, Reimagined
        </p>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-6xl"
        >
          Remember what matters. Privately.
        </h1>
        <p
          class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-secondary)]"
        >
          Capture important information, organize commitments, and rediscover
          your memories with on-device AI. Built for Android with zero cloud
          lock-in.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/download"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-[var(--accent-primary)] px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]"
          >
            <Smartphone class="h-5 w-5" aria-hidden="true" />
            <span>Get Android app</span>
          </a>
          <a
            href="/how-it-works"
            class="inline-flex min-h-[48px] items-center gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-6 py-3 text-base font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-tertiary)]"
          >
            <span>How it works</span>
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

        <p class="mt-6 text-sm text-[var(--text-muted)]">
          Local-first AI &middot; Android &middot; User-controlled capture
        </p>
      </div>

      <!-- Illustrative Memory Preview -->
      <div class="lg:col-span-5">
        <div
          class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6 shadow-sm"
          aria-label="Illustrative Retenqo memory interface"
        >
          <div
            class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4"
          >
            <span class="text-sm font-semibold text-[var(--text-primary)]"
              >Your memory</span
            >
            <span
              class="rounded-full bg-[var(--accent-soft)] px-2.5 py-0.5 text-xs font-medium text-[var(--accent-primary)]"
            >
              On-device
            </span>
          </div>

          <div class="mt-4 space-y-3">
            <div
              class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-4"
            >
              <p
                class="text-[11px] font-semibold tracking-wider text-[var(--accent-primary)] uppercase"
              >
                Upcoming Commitment
              </p>
              <p class="mt-1 font-semibold text-[var(--text-primary)]">
                Submit project report
              </p>
              <p class="mt-0.5 text-xs text-[var(--text-muted)]">
                Tomorrow &middot; 10:00 AM
              </p>
            </div>

            <div
              class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-4"
            >
              <p
                class="text-[11px] font-semibold tracking-wider text-[var(--text-muted)] uppercase"
              >
                Saved Memory
              </p>
              <p class="mt-1 text-sm font-medium text-[var(--text-primary)]">
                Meeting discussion notes
              </p>
            </div>

            <div
              class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-4"
            >
              <p
                class="text-[11px] font-semibold tracking-wider text-[var(--text-muted)] uppercase"
              >
                Saved Memory
              </p>
              <p class="mt-1 text-sm font-medium text-[var(--text-primary)]">
                Shared document details
              </p>
            </div>
          </div>

          <div
            class="mt-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-4 py-3 text-sm text-[var(--text-muted)]"
          >
            Ask your memory...
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow Section -->
  <section
    class="border-b border-[var(--border-subtle)] bg-[var(--bg-secondary)] py-16 sm:py-20"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <h2
          class="text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl"
        >
          From information to meaningful action.
        </h2>
        <p class="mt-3 text-base text-[var(--text-secondary)]">
          A four-stage local pipeline designed to keep your personal context
          useful without sacrificing privacy.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          workflowSteps.map((item) => (
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-6">
              <span class="text-xs font-bold tracking-widest text-[var(--accent-primary)]">
                {item.step}
              </span>
              <h3 class="mt-2 text-lg font-semibold text-[var(--text-primary)]">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Capabilities Grid -->
  <section
    class="border-b border-[var(--border-subtle)] bg-[var(--bg-primary)] py-16 sm:py-20"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <h2
            class="text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl"
          >
            Designed for real-world recall.
          </h2>
          <p class="mt-3 text-base text-[var(--text-secondary)]">
            Every feature is built around user consent, offline reliability, and
            verifiable answers.
          </p>
        </div>
        <a
          href="/features"
          class="inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-hover)]"
        >
          <span>Explore all features</span>
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((cap) => {
            const Icon = cap.icon;
            return (
              <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6">
                <Icon
                  class="h-6 w-6 text-[var(--accent-primary)]"
                  aria-hidden="true"
                />
                <h3 class="mt-4 text-base font-semibold text-[var(--text-primary)]">
                  {cap.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                  {cap.description}
                </p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--bg-secondary)] py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <h2
        class="text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl"
      >
        Ready to own your personal memory?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-[var(--text-secondary)]">
        Download the official Android APK directly from GitHub Releases, verify
        its SHA-256 checksum, and run it on your own device.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/download"
          class="inline-flex min-h-[48px] items-center gap-2 rounded-xl bg-[var(--accent-primary)] px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]"
        >
          <span>Go to Download Page</span>
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
        <a
          href="/privacy"
          class="inline-flex min-h-[48px] items-center rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] px-6 py-3 text-base font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-tertiary)]"
        >
          Read Privacy Policy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
