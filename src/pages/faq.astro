---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_CATEGORIES, FAQ_ITEMS } from '../data/faq';
---

<BaseLayout
  title="FAQ"
  description="Frequently asked questions about Retenqo's privacy, installation, AI, and troubleshooting."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p
      class="text-xs font-semibold tracking-widest text-[var(--accent-primary)] uppercase"
    >
      Support
    </p>
    <h1
      class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl"
    >
      Frequently Asked Questions
    </h1>
    <p class="mt-4 text-base text-[var(--text-secondary)]">
      Answers for everyday users, privacy-conscious users, and technical
      reviewers. Works with or without JavaScript.
    </p>

    <div class="mt-12 space-y-12">
      {
        FAQ_CATEGORIES.map((category) => {
          const items = FAQ_ITEMS.filter((item) => item.category === category);
          return (
            <section
              aria-labelledby={`cat-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            >
              <h2
                id={`cat-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                class="text-xl font-bold text-[var(--text-primary)]"
              >
                {category}
              </h2>
              <div class="mt-4 divide-y divide-[var(--border-subtle)] rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)]">
                {items.map((item) => (
                  <details id={item.id} class="group p-5">
                    <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-4 font-medium text-[var(--text-primary)]">
                      <span>{item.question}</span>
                      <span
                        aria-hidden="true"
                        class="text-lg text-[var(--text-muted)] transition-transform group-open:rotate-45"
                      >
                        +
                      </span>
                    </summary>
                    <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
                      {item.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
