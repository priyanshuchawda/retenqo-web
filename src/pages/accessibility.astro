---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';
---

<BaseLayout
  title="Accessibility"
  description="Retenqo website accessibility statement and WCAG 2.2 AA commitment."
>
  <article class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p
      class="text-xs font-semibold tracking-widest text-[var(--accent-primary)] uppercase"
    >
      Inclusivity
    </p>
    <h1
      class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl"
    >
      Accessibility Statement
    </h1>
    <p class="mt-4 text-base text-[var(--text-secondary)]">
      Retenqo is committed to making its official website accessible to
      everyone, targeting conformance with WCAG 2.2 Level AA.
    </p>

    <div
      class="mt-10 space-y-6 text-sm leading-relaxed text-[var(--text-secondary)]"
    >
      <section>
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">
          Implemented Measures
        </h2>
        <ul class="mt-2 list-disc space-y-1.5 pl-5">
          <li>
            Semantic HTML landmarks (header, nav, main, footer) and logical
            heading hierarchy.
          </li>
          <li>
            Skip-to-content link and full keyboard navigation with visible focus
            indicators.
          </li>
          <li>
            Minimum 44&times;44 CSS pixel interactive targets and 4.5:1 text
            contrast.
          </li>
          <li>
            Native <code>&lt;details&gt;/&lt;summary&gt;</code> disclosures that work
            without JavaScript.
          </li>
          <li>
            Support for <code>prefers-reduced-motion</code> and system light/dark
            themes.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">
          Feedback
        </h2>
        <p class="mt-2">
          If you encounter any accessibility barriers, please email{' '}
          <a
            href={`mailto:${SITE_CONFIG.contactEmail}`}
            class="text-[var(--accent-primary)] underline"
          >
            {SITE_CONFIG.contactEmail}
          </a>
          .
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
