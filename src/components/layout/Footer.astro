---
import { SITE_CONFIG } from '../../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-subtle)] bg-[var(--bg-secondary)]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a
          href="/"
          class="flex items-center gap-2 text-base font-bold text-[var(--text-primary)]"
        >
          <img
            src="/favicon.svg"
            alt=""
            width="24"
            height="24"
            class="h-6 w-6 rounded"
          />
          <span>{SITE_CONFIG.name}</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          Private, on-device AI personal memory assistant for Android. No
          tracking cookies, no cloud AI lock-in.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">
          Product
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="/features"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Features</a>
          </li>
          <li>
            <a
              href="/how-it-works"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >How It Works</a>
          </li>
          <li>
            <a
              href="/download"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Download APK</a>
          </li>
          <li>
            <a
              href="/installation"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Installation Guide</a>
          </li>
          <li>
            <a
              href="/faq"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >FAQ</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">
          Trust &amp; Security
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="/privacy"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Privacy Policy</a>
          </li>
          <li>
            <a
              href="/security"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Security Architecture</a>
          </li>
          <li>
            <a
              href="/permissions"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Android Permissions</a>
          </li>
          <li>
            <a
              href="/accessibility"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Accessibility</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">
          Open Source
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href={SITE_CONFIG.appRepoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              Android App Repository
            </a>
          </li>
          <li>
            <a
              href={SITE_CONFIG.appReleasesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              Official GitHub Releases
            </a>
          </li>
          <li>
            <a
              href={SITE_CONFIG.webRepoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              Website Source
            </a>
          </li>
          <li>
            <a
              href="/support"
              class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              >Support &amp; Bugs</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-[var(--border-subtle)] pt-6 text-xs text-[var(--text-muted)] sm:flex-row sm:items-center"
    >
      <p>&copy; {currentYear} Retenqo. Built with privacy-first engineering.</p>
      <p>Static distribution &middot; Zero tracking cookies</p>
    </div>
  </div>
</footer>
