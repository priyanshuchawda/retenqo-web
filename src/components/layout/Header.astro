---
import { SITE_CONFIG } from '../../config/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-[var(--text-primary)] hover:opacity-90"
      aria-label="Retenqo home"
    >
      <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7 rounded-md" />
      <span>{SITE_CONFIG.name}</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden md:flex md:items-center md:gap-1">
      {
        SITE_CONFIG.nav.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          const isDownload = item.href === '/download';
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={
                isDownload
                  ? 'ml-2 inline-flex min-h-[44px] items-center rounded-lg bg-[var(--accent-primary)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]'
                  : `inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                      isActive
                        ? 'bg-[var(--bg-tertiary)] text-[var(--text-primary)]'
                        : 'text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]'
                    }`
              }
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <details class="relative md:hidden">
      <summary
        class="inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-secondary)] px-3 py-2 text-sm font-medium text-[var(--text-primary)]"
        aria-label="Toggle navigation menu"
      >
        Menu
      </summary>
      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 mt-2 w-56 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-2 shadow-lg"
      >
        <ul class="flex flex-col gap-1">
          {
            SITE_CONFIG.nav.map((item) => {
              const isActive = currentPath === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-medium ${
                      isActive
                        ? 'bg-[var(--bg-tertiary)] text-[var(--text-primary)]'
                        : 'text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]'
                    }`}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
